{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aavc.local/schema/project.schema.json",
  "title": "AAVC Project Schema",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "source_docx",
    "asset_directory",
    "scenes",
    "bindings"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "title": {"type": "string", "minLength": 1},
    "source_docx": {"type": "string"},
    "asset_directory": {"type": "string"},
    "scenes": {"type": "array"},
    "bindings": {"type": "array"},
    "animations": {
      "type": "array",
      "items": {"$ref": "#/$defs/animationAssignment"}
    }
  },
  "$defs": {
    "animationKeyframe": {
      "type": "object",
      "required": ["time", "value"],
      "properties": {
        "time": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "value": {"type": "number"},
        "interpolation": {"enum": ["hold", "linear", "bezier"]},
        "easing": {"enum": ["linear", "ease_in", "ease_out", "ease_in_out"]},
        "velocity": {"type": ["number", "null"]},
        "overshoot": {"type": ["number", "null"], "minimum": 0.0}
      },
      "additionalProperties": true
    },
    "animationKeyframeTrack": {
      "type": "object",
      "required": ["property_name", "keyframes"],
      "properties": {
        "property_name": {
          "enum": [
            "position_x", "position_y", "scale", "rotation_degrees", "opacity",
            "crop_left", "crop_top", "crop_right", "crop_bottom", "blur",
            "shadow", "glow", "mask_progress"
          ]
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/animationKeyframe"}
        }
      },
      "additionalProperties": true
    },
    "animationAssignment": {
      "type": "object",
      "required": ["scene_number", "asset_id"],
      "properties": {
        "scene_number": {"type": "integer"},
        "asset_id": {"type": "string", "minLength": 1},
        "enter_effect": {"type": "string"},
        "exit_effect": {"type": "string"},
        "intensity": {"type": "number", "minimum": 0.0},
        "locked": {"type": "boolean"},
        "keyframe_tracks": {
          "type": "array",
          "items": {"$ref": "#/$defs/animationKeyframeTrack"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
